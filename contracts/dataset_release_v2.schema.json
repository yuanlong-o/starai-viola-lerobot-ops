{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurolabware.invalid/viola/v2/dataset_release.schema.json",
  "title": "Viola training-only dataset_release payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "dataset_repo_id",
    "task",
    "source",
    "selection",
    "dataset",
    "validation"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "release_id": {"type": "string", "pattern": "(^|[-_])v[0-9]+($|[-_])"},
    "dataset_repo_id": {"type": "string", "minLength": 1},
    "task": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_id", "root", "lerobot_version", "episodes", "frames", "inventory"],
      "properties": {
        "repo_id": {"type": "string", "minLength": 1},
        "root": {"type": "string", "minLength": 1},
        "lerobot_version": {"type": "string", "minLength": 1},
        "episodes": {"type": "integer", "minimum": 1},
        "frames": {"type": "integer", "minimum": 1},
        "inventory": {"$ref": "#/$defs/sourceInventory"}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_source_episode_ids",
        "reviewed_filter_manifest_canonical_sha256",
        "train_episode_indices",
        "evaluation_episode_indices",
        "split_sha256"
      ],
      "properties": {
        "accepted_source_episode_ids": {"$ref": "#/$defs/episodes"},
        "reviewed_filter_manifest_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "train_episode_indices": {"$ref": "#/$defs/episodes"},
        "evaluation_episode_indices": {"$ref": "#/$defs/episodes"},
        "split_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_name",
        "root",
        "inventory_sha256",
        "file_count",
        "byte_count",
        "episodes",
        "frames",
        "fps",
        "robot_type",
        "video_keys",
        "video_backend"
      ],
      "properties": {
        "artifact_name": {"const": "dataset"},
        "root": {"type": "string", "pattern": "^/"},
        "inventory_sha256": {"$ref": "#/$defs/sha256"},
        "file_count": {"type": "integer", "minimum": 1},
        "byte_count": {"type": "integer", "minimum": 1},
        "episodes": {"type": "integer", "minimum": 2},
        "frames": {"type": "integer", "minimum": 2},
        "fps": {"type": "integer", "minimum": 1},
        "robot_type": {"type": "string", "minLength": 1},
        "video_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "video_backend": {"const": "pyav"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "status",
        "normalization_scope",
        "validation_sha256",
        "qualification_sha256",
        "evidence_sha256",
        "normalization"
      ],
      "properties": {
        "mode": {"const": "fresh_build"},
        "status": {"const": "passed"},
        "normalization_scope": {"const": "training_only"},
        "validation_sha256": {"$ref": "#/$defs/sha256"},
        "qualification_sha256": {"type": "null"},
        "evidence_sha256": {
          "type": "object",
          "minProperties": 3,
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        },
        "normalization": {"$ref": "#/$defs/normalization"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "episodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "sourceInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "sha256", "file_count", "byte_count"],
      "properties": {
        "algorithm": {"const": "viola_legacy_tree_v1"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "file_count": {"type": "integer", "minimum": 1},
        "byte_count": {"type": "integer", "minimum": 1}
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "train_episodes",
        "evaluation_episodes",
        "train_frames",
        "split_sha256",
        "stats_sha256"
      ],
      "properties": {
        "scope": {"const": "training_only"},
        "train_episodes": {"$ref": "#/$defs/episodes"},
        "evaluation_episodes": {"$ref": "#/$defs/episodes"},
        "train_frames": {"type": "integer", "minimum": 1},
        "split_sha256": {"$ref": "#/$defs/sha256"},
        "stats_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
