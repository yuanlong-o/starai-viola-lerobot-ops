+# Direct degree limits corresponding to the Viola URDF. The gripper command is
+# expressed in degrees by the upstream SetAngle message.
+SERVO_ANGLE_LIMITS = [
+    (-130.1, 130.1),
+    (-90.0, 90.0),
+    (-90.0, 90.0),
+    (-130.1, 130.1),
+    (-90.0, 90.0),
