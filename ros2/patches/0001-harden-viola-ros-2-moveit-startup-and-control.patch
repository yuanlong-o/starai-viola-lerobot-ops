+class FakeGoalHandle:
+    def __init__(self, request):
+        self.request = request
+        self.is_cancel_requested = False
+        self.status = None
+
+    def abort(self):
+        self.status = "aborted"
+
+    def canceled(self):
+        self.status = "canceled"
+
+    def succeed(self):
