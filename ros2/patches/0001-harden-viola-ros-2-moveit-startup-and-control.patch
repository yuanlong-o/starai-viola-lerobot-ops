+def test_complete_joint_state_is_reordered_into_servo_id_order():
+    names = list(reversed(ALL_JOINTS))
+    positions_by_name = {name: index * 0.01 for index, name in enumerate(ALL_JOINTS)}
+    positions_by_name["joint7_left"] = -0.01
+    msg = JointState(
+        name=names,
+        position=[positions_by_name[name] for name in names],
