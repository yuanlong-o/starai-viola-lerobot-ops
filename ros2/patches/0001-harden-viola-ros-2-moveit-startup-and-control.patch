+class FakeSerial:
+    def __init__(self, **kwargs):
+        self.kwargs = kwargs
+        self.is_open = True
+        self.writes = []
+        self.flush_count = 0
+
+    def write(self, packet):
+        self.writes.append(packet)
+        return len(packet)
+
+    def flush(self):
+        self.flush_count += 1
+
+    def close(self):
+        self.is_open = False
+
+
+class FailingSerial(FakeSerial):
+    def write(self, _packet):
+        raise serial.SerialException("disconnected")
+
+
+class ShortWriteSerial(FakeSerial):
+    def write(self, packet):
+        self.writes.append(packet)
+        return len(packet) - 1
+
+
+class FakeManager:
+    CODE_SET_SERVO_ANGLE_MTURN_BY_INTERVAL = 0x01
+
+    def __init__(self, uart):
+        self.uart = uart
+        self.servos = {
+            servo_id: SimpleNamespace(angle_monitor=float(servo_id * 10))
+            for servo_id in range(7)
+        }
+        self.calls = []
+
+    def disable_torque(self, servo_id):
+        self.calls.append(("disable_torque", servo_id))
+
+    def reset_multi_turn_angle(self, servo_id):
+        self.calls.append(("reset_multi_turn_angle", servo_id))
+
+    def send_sync_servo_monitor(self, servo_ids):
+        self.calls.append(("monitor", tuple(servo_ids)))
+        for servo_id in servo_ids:
+            self.servos[servo_id].angle_monitor = float(servo_id * 10)
+
+    def send_sync_multiturnanglebyinterval(self, command_id, size, data):
+        self.calls.append(("write", command_id, size, len(data)))
+
+    def stop_on_control_mode(self, servo_id, mode, power):
+        self.calls.append(("stop", servo_id, mode, power))
+
+
+class FakeLogger:
+    def __init__(self):
+        self.messages = []
+
+    def error(self, message):
+        self.messages.append(("error", message))
+
+    def warning(self, message):
+        self.messages.append(("warning", message))
+
+
+def make_arm(reset_multiturn=False, serial_factory=FakeSerial):
+    return uservo_ex(
+        "viola",
+        serial_port="/dev/fake",
+        baudrate=1_000_000,
+        reset_multiturn=reset_multiturn,
+        serial_factory=serial_factory,
+        manager_factory=FakeManager,
+        kernel_exclusive=lambda _uart: None,
+    )
+
+
+def test_default_construction_does_not_reset_or_disable_torque():
