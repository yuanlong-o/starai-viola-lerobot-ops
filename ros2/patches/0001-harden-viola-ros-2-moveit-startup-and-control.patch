+    def _fresh_or_read_current_angles(self) -> list[float]:
+        if (
+            self._last_current_angle_monotonic is not None
+            and time.monotonic() - self._last_current_angle_monotonic
+            <= COMMAND_FEEDBACK_TIMEOUT_S
