+
+def require_finite_parameter(name: str, value: float) -> None:
+    if not math.isfinite(value):
+        raise ValueError(f"{name} must be finite")
+
+
+def apply_kernel_exclusive(uart: Any) -> None:
+    """Prevent later opens of this Linux tty until the descriptor closes."""
+
+    fcntl.ioctl(uart.fileno(), termios.TIOCEXCL)
+
+
+def quantize_target_tenths(servo_id: int, target_angle: float) -> int:
+    """Round to the servo's 0.1° units without crossing a model limit."""
+
+    lower, upper = SERVO_ANGLE_LIMITS[servo_id]
+    rounded = int(round(target_angle * 10))
+    return min(math.floor(upper * 10), max(math.ceil(lower * 10), rounded))
+
+
+def validate_measured_angles(angles: list[float]) -> None:
+    """Reject missing, corrupt, or implausible seven-servo feedback."""
+
+    if len(angles) != len(SERVO_IDS):
+        raise ValueError(f"expected seven measured angles, received {len(angles)}")
+    for servo_id, angle in enumerate(angles):
+        if not math.isfinite(angle):
+            raise ValueError(f"servo {servo_id} measured angle is not finite")
+        lower, upper = SERVO_ANGLE_LIMITS[servo_id]
+        if not (
+            lower - MEASURED_ANGLE_MARGIN_DEG
+            <= angle
+            <= upper + MEASURED_ANGLE_MARGIN_DEG
+        ):
+            raise ValueError(
+                f"servo {servo_id} measured angle {angle:.3f}° is implausible; "
+                f"expected [{lower - MEASURED_ANGLE_MARGIN_DEG:.3f}, "
+                f"{upper + MEASURED_ANGLE_MARGIN_DEG:.3f}]°"
+            )
+
+
+def validate_command_speed(
+    servo_ids: list[int],
+    target_angles: list[float],
+    times_ms: list[int],
+    measured_angles: list[float],
+) -> None:
+    """Enforce model speed limits against fresh measured feedback."""
+
+    validate_measured_angles(measured_angles)
+    for servo_id, target_angle, duration_ms in zip(
+        servo_ids,
+        target_angles,
+        times_ms,
+        strict=True,
+    ):
+        required_speed = abs(target_angle - measured_angles[servo_id]) / (
+            duration_ms / 1000
+        )
+        max_speed = MAX_SERVO_SPEED_DPS[servo_id]
+        if required_speed > max_speed + 1e-6:
+            raise ValueError(
+                f"servo {servo_id} requires {required_speed:.3f}°/s, exceeding "
+                f"the {max_speed:.3f}°/s limit"
+            )
+
+
+def validate_angle_command(
+    servo_ids: list[int],
+    target_angles: list[float],
+    times_ms: list[int],
+) -> None:
+    """Reject malformed or out-of-range commands before writing any servo."""
+
+    if not servo_ids:
+        raise ValueError("servo_id cannot be empty")
+    if not (len(servo_ids) == len(target_angles) == len(times_ms)):
+        raise ValueError("servo_id, target_angle, and time arrays must have equal lengths")
+    if len(set(servo_ids)) != len(servo_ids):
+        raise ValueError("servo_id contains duplicates")
+
+    for servo_id, target_angle, duration_ms in zip(
+        servo_ids,
+        target_angles,
+        times_ms,
+        strict=True,
+    ):
+        if servo_id not in SERVO_IDS:
+            raise ValueError(f"invalid servo id {servo_id}; expected 0 through 6")
+        if not math.isfinite(target_angle):
+            raise ValueError(f"servo {servo_id} target is not finite")
+        lower, upper = SERVO_ANGLE_LIMITS[servo_id]
+        if not lower <= target_angle <= upper:
+            raise ValueError(
+                f"servo {servo_id} target {target_angle:.3f}° is outside "
+                f"[{lower:.3f}, {upper:.3f}]°"
+            )
+        if duration_ms < 40 or duration_ms > 120_000:
+            raise ValueError(
+                f"servo {servo_id} duration {duration_ms} ms is outside [40, 120000]"
+            )
 
