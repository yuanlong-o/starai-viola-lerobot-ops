+
+
+DEFAULT_SERIAL_PORT = "/dev/serial/by-path/pci-0000:00:14.0-usb-0:10:1.0-port0"
+
+
+def generate_launch_description() -> LaunchDescription:
+    arguments = [
+        DeclareLaunchArgument("serial_port", default_value=DEFAULT_SERIAL_PORT),
+        DeclareLaunchArgument("baudrate", default_value="1000000"),
+        DeclareLaunchArgument("startup_mode", default_value="hold_current"),
+        DeclareLaunchArgument("reset_multiturn", default_value="false"),
+        DeclareLaunchArgument("hold_motion_time_ms", default_value="100"),
+        DeclareLaunchArgument("home_motion_time_ms", default_value="1500"),
+        DeclareLaunchArgument("shutdown_mode", default_value="damping"),
+        DeclareLaunchArgument("feedback_fault_timeout_s", default_value="0.5"),
+    ]
+
+    driver = Node(
+        package="robo_driver",
+        executable="driver",
+        name="viola_driver",
+        output="screen",
+        emulate_tty=True,
+        parameters=[
+            {
+                "robo_type": "viola",
+                "serial_port": LaunchConfiguration("serial_port"),
+                "baudrate": ParameterValue(LaunchConfiguration("baudrate"), value_type=int),
+                "startup_mode": LaunchConfiguration("startup_mode"),
+                "reset_multiturn": ParameterValue(
+                    LaunchConfiguration("reset_multiturn"), value_type=bool
+                ),
+                "hold_motion_time_ms": ParameterValue(
+                    LaunchConfiguration("hold_motion_time_ms"), value_type=int
+                ),
+                "home_motion_time_ms": ParameterValue(
+                    LaunchConfiguration("home_motion_time_ms"), value_type=int
+                ),
+                "shutdown_mode": LaunchConfiguration("shutdown_mode"),
+                "feedback_fault_timeout_s": ParameterValue(
+                    LaunchConfiguration("feedback_fault_timeout_s"),
+                    value_type=float,
+                ),
+            }
+        ],
+    )
+
+    controller = Node(
+        package="viola_controller",
+        executable="controller",
+        name="viola_controller",
+        output="screen",
+        emulate_tty=True,
+    )
+
+    return LaunchDescription([*arguments, driver, controller])
