+def test_gripper_units_round_trip_at_urdf_limits():
+    assert jointstate2servoangle(6, 0.0) == pytest.approx(100.0)
+    assert jointstate2servoangle(6, -0.03) == pytest.approx(6.25)
+    assert servo_degrees_to_gripper_meters(100.0) == pytest.approx(0.0)
+    assert servo_degrees_to_gripper_meters(6.25) == pytest.approx(-0.03)
+
+
+def test_invalid_servo_id_is_rejected():
+    with pytest.raises(ValueError):
+        jointstate2servoangle(7, 0.0)
+
+
+def test_nonfinite_controller_parameter_is_rejected():
+    with pytest.raises(ValueError, match="must be finite"):
+        require_finite_parameter("joint_state_timeout_s", float("nan"))
