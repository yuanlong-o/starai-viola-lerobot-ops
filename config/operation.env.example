# Copy to config/operation.env and update paths after USB discovery on a new PC.
# This file is sourced by scripts/run_viola_inference.sh; keep it shell-safe.

LEROBOT_ENV_NAME=lerobot
VIOLA_ROBOT_PORT=/dev/serial/by-path/pci-0000:00:14.0-usb-0:10:1.0-port0
VIOLA_TELEOP_PORT=/dev/serial/by-path/pci-0000:00:14.0-usb-0:11:1.0-port0
VIOLA_FRONT_CAMERA=/dev/v4l/by-id/usb-046d_0825_543F8BC0-video-index0
VIOLA_UP_CAMERA=/dev/v4l/by-id/usb-046d_0825_A8E49440-video-index0
VIOLA_ROBOT_ID=my_awesome_staraiviola_arm
VIOLA_TELEOP_ID=my_awesome_staraiviolin_arm
VIOLA_POLICY_DIR=${HOME}/models/act_viola_val20_step080000
VIOLA_CUDA_DEVICE=0
VIOLA_MAX_STEP=3.0

# Local-only LeRobot episode datasets. Recording is included for operation;
# model training remains in the separate training repository.
VIOLA_DATASET_DIR=${HOME}/lerobot-data
VIOLA_DATASET_NAMESPACE=local
